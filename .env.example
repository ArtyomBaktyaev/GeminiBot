# Скопируй в .env (файл .env НЕ коммитится) и заполни.
TELEGRAM_BOT_TOKEN=
# Ключи Google AI Studio через запятую
GEMINI_KEYS=key1,key2,key3
TARGET_CHAT_ID=-1003900095395

# --- необязательно ---
# Telegram user ID админов через запятую (если пусто — доступ у всех)
ADMIN_IDS=
# Доп. группы, где бот отвечает на вопросы (через запятую; ID узнать командой /chatid)
ALLOWED_CHAT_IDS=
GEMINI_MODEL=gemini-3.8-flash
BOT_TZ=Europe/Moscow
# Час ежедневных напоминаний (по BOT_TZ)
DAILY_HOUR=9
HISTORY_WINDOW=20
MAX_MEDIA_PER_THREAD=3
MEDIA_BUDGET_MB=60
# Сохранение topics/tasks/settings между перезапусками (секретный GitHub Gist + токен со scope "gist")
GIST_ID=
GIST_TOKEN=
