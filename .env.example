# Скопируй в .env (файл .env НЕ коммитится в Git) и заполни.
TELEGRAM_BOT_TOKEN=
# Ключи Google AI Studio (aistudio.google.com) через запятую для общего пула
GEMINI_KEYS=key1,key2,key3
TARGET_CHAT_ID=

# --- КРИТИЧЕСКИ ВАЖНО ---
# Твой Telegram User ID (и других админов через запятую).
# ОБЯЗАТЕЛЬНО укажи свой ID, чтобы включить админ-доступ и изолировать настройки!
# Свой ID можно узнать у бота командой /id или в ботах вроде @userinfobot
ADMIN_IDS=

# --- необязательно ---
# Доп. группы, где бот отвечает на вопросы (через запятую; ID узнать командой /chatid)
ALLOWED_CHAT_IDS=
# Основная модель (gemini-4-hydrogen, gemini-4-argon, gemini-3.5-flash-lite, gemini-2.5-flash)
GEMINI_MODEL=gemini-4-hydrogen
BOT_TZ=Europe/Moscow
# Час ежедневных напоминаний (по BOT_TZ)
DAILY_HOUR=9
HISTORY_WINDOW=20
MAX_MEDIA_PER_THREAD=3
MEDIA_BUDGET_MB=60
# Сохранение topics/tasks/settings между перезапусками (секретный GitHub Gist + токен со scope "gist")
GIST_ID=
GIST_TOKEN=
